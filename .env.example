# Application Runtime Settings
app_name="District Administration OCR & Verification Platform"
app_env=development
app_version=1.0.0
host=127.0.0.1
port=8003
debug_mode=false
api_prefix=/api/v1

# Security & CORS Settings
# Comma-separated allowed origins for CORS
allowed_origins=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
secret_key=insecure_change_me_in_production_district_ocr_secret_key_64_chars

# Zero-Data-Retention (ZDR) Baseline Configuration
# Maximum ephemeral memory buffer allowed per document in megabytes (MB)
max_file_size_mb=15
# Lifespan of any temporary memory artifact in seconds (strict ephemeral retention)
ephemeral_ttl_seconds=300
# Force in-memory wipe after processing
enforce_in_memory_wipe=true

# Celery & Redis Background Pipeline
redis_url=redis://127.0.0.1:6379/0
celery_task_default_queue=district_ocr_tasks

# Master Reference Database (Read-Only PostgreSQL Connection)
database_url_read_only=postgresql+asyncpg://readonly_user:readonly_secure_password@127.0.0.1:5432/municipal_reference_db

# Pre-Flight Quality Gate & Matching Thresholds
quality_gate_min_score=40.0
fuzzy_match_auto_correct_threshold=85.0
fuzzy_match_manual_review_threshold=70.0
